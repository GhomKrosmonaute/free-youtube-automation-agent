# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# ── 100% free & local (this fork) ─────────────────────────────
# Text: Ollama on this machine. Any non-empty key works; Ollama ignores it.
#   brew install ollama && ollama serve && ollama pull qwen2.5:7b
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# Voice: built-in macOS speech synthesis (macOS only). List voices: say -v '?'
# TTS_PROVIDER=macos_say
# TTS_VOICE=Samantha
# TTS_RATE=175
# Language for scripts, metadata and captions (ISO code)
# CONTENT_LANGUAGE=en
# CONTENT_MODE=standard              # standard: explainer videos; react: the channel also reacts to watched channels and
#                                     # trending claims, as its react profile says (REACT_PROFILE). See README.
# REACT_PROFILE=config/react-profile.js   # the react profile (see config/react-profile.example.js)

# AI Provider - Pick one (or use OpenRouter for access to all)
# Uncomment the line you use — placeholder values must stay commented out
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# ElevenLabs TTS (optional, higher quality than OpenAI TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here

# AI video generation (optional; local slideshow is the no-cost default)
# VIDEO_PROVIDER=slideshow
# VIDEO_PROVIDER_ORDER=seedance,minimax_h3,google_omni,kling,wan,slideshow
# VIDEO_GENERATION_MODE=hybrid
# VIDEO_CLIP_DURATION=8
# VIDEO_MAX_GENERATED_SECONDS=60
# VIDEO_RESOLUTION=720p
# VIDEO_ASPECT_RATIO=16:9

# Seedance 2.5 through Replicate
# REPLICATE_API_TOKEN=your-replicate-api-token-here
# REPLICATE_API_KEY=your-replicate-api-token-here
# SEEDANCE_MODEL=bytedance/seedance-2.5

# MiniMax H3
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_VIDEO_MODEL=MiniMax-H3

# Google Gemini Omni Flash uses GEMINI_API_KEY above
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Kling 3.0 Omni
# KLING_ACCESS_KEY=your-kling-access-key-here
# KLING_SECRET_KEY=your-kling-secret-key-here
# KLING_VIDEO_MODEL=kling-v3-omni

# Alibaba Wan 2.7
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_VIDEO_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# DASHSCOPE_TASK_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/tasks

# Gemini media generation (used when GEMINI_API_KEY is your provider)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# DarkzSEO discoverability preflight (bundled and advisory; external checkout is explicit and falls back safely)
# DARKZSEO_PYTHON=python
# DARKZSEO_PATH=../darkzseo/darkzseo.py
# DARKZSEO_TIMEOUT_MS=30000

# Optional OAuth loopback override; Desktop app credentials are required.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1

# Azure Speech TTS (optional alternative)
# AZURE_SPEECH_KEY=your-azure-speech-key-here
# AZURE_SPEECH_REGION=eastus

# Application Settings
NODE_ENV=production
PORT=3456
# The dashboard binds to loopback only unless HOST is set explicitly
HOST=127.0.0.1
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# YouTube Settings
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# Shorts on other platforms (credentials: npm run credentials:setup -- tiktok | instagram)
# Platforms that receive every approved Short; a platform without credentials is skipped.
SOCIAL_PLATFORMS=youtube
# SOCIAL_PLATFORMS=youtube,tiktok,instagram
# draft: the video lands in the TikTok inbox and you publish it from the app (works before TikTok's app audit).
# direct: posted by the agent (scope video.publish); TikTok keeps posts private until the app passes its audit.
TIKTOK_POST_MODE=draft
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# Reels also shown in the profile grid (Feed tab)
INSTAGRAM_SHARE_TO_FEED=true

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
# Strongly recommended: mutating API routes require this value in the x-api-key header.
# Generate one with: openssl rand -hex 24
API_KEY=

# Optional. Generation jobs run one at a time by default to control API spend.
MAX_CONCURRENT_JOBS=1

# Optional. Each retry-safe generation stage gets one bounded retry by default.
GENERATION_STAGE_MAX_ATTEMPTS=2
GENERATION_RETRY_BASE_MS=1000

# Optional Slack/Discord-compatible webhook for failures and review alerts.
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/...

# Expert review of scripts on highly specialised subjects (quantum physics, relativity, clinical medicine...).
# Right after the script is written, a model decides whether a specialist must check it. If so, the video waits
# before narration and images, the webhook below receives what to check (Slack/Discord-compatible JSON: short
# `text`/`content`, plus `review`, the full `script` and the `actions`), and nothing goes further until
# `npm run expert -- approve|revise|reject <id>` (revise: the script is rewritten with the corrections, then reviewed again).
# EXPERT_REVIEW=auto                  # auto (a model decides) | always (every script) | off
# EXPERT_REVIEW_WEBHOOK_URL=https://hooks.example.com/...   # falls back to NOTIFICATION_WEBHOOK_URL
# EXPERT_REVIEW_MENTION=<@123456789012345678>   # who the alert pings: Discord user id, <@&role id>, @here; Slack <@U...>
# EXPERT_REVIEW_DOMAINS=quantum physics;relativity and cosmology;clinical medicine   # replaces the default list
# EXPERT_REVIEW_MODEL=                # assessment model (default: the script model)
# EXPERT_REVIEW_CONFIDENCE=6.6        # a passage scored above this (out of 10) is validated without an expert
# TYPESAFE_API_KEY=                   # Jev sorts scripts before the Claude assessment (console.typesafe.ai/keys); JEV=off disables it
# EXPERT_TRIAGE_THRESHOLD=0.25        # below this probability of a specialised subject, Jev spares the Claude assessment
# EXPERT_REVIEWER=                    # name recorded with the decisions taken from this machine

# AI_USAGE_LOG=data/ai-usage.jsonl   # every Claude call's purpose, tokens and cost (npm run ai-usage); off disables it

# SITE_BASE_URL=https://<owner>.github.io/<repository>   # public verification site, linked from descriptions
# SITE_REPO=<owner>/<repository>      # GitHub Pages repository the site is pushed to (no default: built locally only)
# SITE_FEEDS=off                      # on also publishes RSS feeds (with SITE_BASE_URL) and the static JSON API (api/v1/)
# YOUTUBE_SEARCH_DAILY=30             # YouTube searches the topic gap finder may spend per day
# GAP_WATCH_MIN_VIEWS=50000           # a channel defending a claim to this many views is watched for viral videos
# REACTIVE=on                         # off stops the 5-minute watch of the watched channels (react mode)
# REACTIVE_DAILY_MAX=4                # answers per day, on top of the normal cadence
# REACTIVE_SERIES_CONFIDENCE=0.7      # an answer is one Short unless Jev is this sure its arguments need a series of Shorts
# REACTIVE_MAX_PARTS=4                # at most this many Shorts in a series (joined into one 16:9 video once all are out)
# REACTIVE_PER_CHANNEL_WEEKLY=2       # answers to one channel per week
# REACTIVE_APPROVAL=jev               # jev: published once every check passes and Jev finds every quotation faithful; human: wait for you
# REACTIVE_MANUAL_MIN_STANCE=0.5      # Jev's certainty that a new video defends a claim, for channels added by hand (0.7 otherwise)
# REACTIVE_API_FALLBACK_MINUTES=15    # minutes between Data API reads of a channel whose public feed fails
# REACTIVE_MIN_VIEWS_PER_HOUR=0       # optional minimum spread before answering (0: every new video is looked at)
# REACTIVE_MIN_VIEWS=0
# WATCH_MAX_CHANNELS=20               # channels watched at once; the lowest-scored automatic one makes room
# WATCH_GRACE_DAYS=14                 # days a newly watched channel cannot be pushed out
# SITE_DIR=data/site                  # local clone the site is built in

# Optional anonymous activation milestones (OFF by default).
# No telemetry is sent unless both values are explicitly configured.
# Payload: milestone name, timestamp, Lumen version, OS family, Node major,
# and a random installation ID. Never includes channel, topic, title, keys, or files.
# ANONYMOUS_TELEMETRY_ENABLED=false
# ANONYMOUS_TELEMETRY_ENDPOINT=https://your-collector.example/events

# Maximum agent-posted comment replies per day (Engagement studio; default 50)
# ENGAGEMENT_DAILY_REPLY_CAP=50

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
